<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="GBC.Tracker.FireTruckTrackerView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Fire Truck Tracker"
    BackgroundColor="{StaticResource PageBackground}">

    <VerticalStackLayout Padding="24" Spacing="12" VerticalOptions="Center">
        <Label
            Style="{StaticResource SectionTitleStyle}"
            HorizontalTextAlignment="Center"
            Text="Fire Truck Tracker" />
        <Label
            HorizontalTextAlignment="Center"
            Text="Live fire truck route tracking will appear here."
            TextColor="{StaticResource SecondaryText}" />
    </VerticalStackLayout>
</ContentPage>
