<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- City of Gulf Breeze inspired palette -->
    <Color x:Key="GulfBreezePrimaryBlue">#0e243d</Color>
    <Color x:Key="GulfBreezeGreen">#0D8744</Color>
    <Color x:Key="GulfBreezeDarkGreen">#3C5F2F</Color>
    <Color x:Key="GulfBreezeBlue">#48A2D4</Color>
    <Color x:Key="GulfBreezeLightBlue">#C2E0F0</Color>
    <Color x:Key="GulfBreezeGold">#E6C421</Color>
    <Color x:Key="GulfBreezeLightGreen">#70BF64</Color>
    <Color x:Key="FireEngineRed">#C62828</Color>
    <Color x:Key="PageBackground">#F4F8F6</Color>
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="PrimaryText">#17352A</Color>
    <Color x:Key="SecondaryText">#65766E</Color>
    <Color x:Key="BorderColor">#DFEAE4</Color>

    <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0.0" Color="{StaticResource GulfBreezePrimaryBlue}" />
        <GradientStop Offset="0.62" Color="#173F66" />
        <GradientStop Offset="1.0" Color="{StaticResource GulfBreezeBlue}" />
    </LinearGradientBrush>

    <Style x:Key="PageTitleStyle" TargetType="Label">
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="LineBreakMode" Value="NoWrap" />
    </Style>

    <Style x:Key="PageSubtitleStyle" TargetType="Label">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="#E7F4ED" />
    </Style>

    <Style x:Key="SectionTitleStyle" TargetType="Label">
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="TextColor" Value="{StaticResource Surface}" />
    </Style>

    <Style x:Key="TrackerTileStyle" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
        <Setter Property="Stroke" Value="{StaticResource BorderColor}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="MinimumHeightRequest" Value="210" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="24" />
        </Setter>
        <Setter Property="Shadow">
            <Shadow Brush="#1F27402F" Offset="0,7" Radius="16" Opacity="0.18" />
        </Setter>
    </Style>

    <Style x:Key="TileIconContainerStyle" TargetType="Border">
        <Setter Property="HeightRequest" Value="68" />
        <Setter Property="WidthRequest" Value="68" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="22" />
        </Setter>
    </Style>

    <Style x:Key="TileIconStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="FontAwesomeSolid" />
        <Setter Property="FontSize" Value="31" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>

    <Style x:Key="TileTitleStyle" TargetType="Label">
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="TextColor" Value="{StaticResource PrimaryText}" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <Style x:Key="TileSubtitleStyle" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource SecondaryText}" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <Style x:Key="StatusPillStyle" TargetType="Border">
        <Setter Property="BackgroundColor" Value="#E7F4ED" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="12" />
        </Setter>
    </Style>

</ResourceDictionary>
